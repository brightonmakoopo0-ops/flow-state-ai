# ---------------------------------------------------------------------------
# WorkFlow AI — environment variables
# Copy this file to `.env` and fill in the values. Never commit real keys.
# ---------------------------------------------------------------------------

# Server-side AI gateway key. Read only inside server functions — never
# exposed to the browser and never prefixed with VITE_.
# On Lovable this key is provisioned automatically; set it manually only when
# running the project outside Lovable.
LOVABLE_API_KEY=your-ai-gateway-key-here

# Optional: port for the local dev server (defaults to 8080)
# PORT=8080
